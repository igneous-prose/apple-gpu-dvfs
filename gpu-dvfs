#!/bin/bash
# gpu-dvfs — wrapper for gpu_freq_ctl (Apple Silicon GPU DVFS control)
#
# Handles build, provides nice subcommands, named presets, powermetrics.
# Run without arguments for help.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BINARY="$SCRIPT_DIR/gpu_freq_ctl"
SOURCE="$SCRIPT_DIR/gpu_freq_ctl.m"

# Colors (disabled if not a terminal)
if [ -t 1 ]; then
    RED='\033[31m'; GREEN='\033[32m'; YELLOW='\033[33m'
    BLUE='\033[34m'; CYAN='\033[36m'; BOLD='\033[1m'
    DIM='\033[2m'; RESET='\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; BLUE=''; CYAN=''; BOLD=''; DIM=''; RESET=''
fi

log_info()  { echo -e "${CYAN}•${RESET} $*"; }
log_ok()    { echo -e "${GREEN}✓${RESET} $*"; }
log_warn()  { echo -e "${YELLOW}⚠${RESET} $*"; }
log_err()   { echo -e "${RED}✗${RESET} $*" >&2; }

# ─── Requirements ──────────────────────────────────────────────────────────

check_requirements() {
    if [[ "$(uname)" != "Darwin" ]]; then
        log_err "This tool requires macOS with Apple Silicon"
        exit 1
    fi
    if ! sysctl -n machdep.cpu.brand_string 2>/dev/null | grep -qi "apple"; then
        log_err "Apple Silicon required (detected: $(sysctl -n machdep.cpu.brand_string 2>/dev/null))"
        exit 1
    fi
    if ! command -v xcrun &>/dev/null; then
        log_err "Xcode Command Line Tools required"
        echo "  Install with: xcode-select --install"
        exit 1
    fi
}

# ─── Build ─────────────────────────────────────────────────────────────────

build_if_needed() {
    if [ ! -f "$BINARY" ] || [ "$SOURCE" -nt "$BINARY" ]; then
        log_info "Building gpu_freq_ctl..."
        xcrun clang -framework IOKit -framework Foundation -framework Metal -O2 \
            -o "$BINARY" "$SOURCE"
        log_ok "Built: $BINARY"
    fi
}

# ─── Preset mapping (watts) ────────────────────────────────────────────────

resolve_preset() {
    local input="$1"
    case "$input" in
        min|minimum|lowest)   echo "1"   ;;
        low)                  echo "2"   ;;
        medium-low|medlow)    echo "5"   ;;
        medium|med)           echo "10"  ;;
        medium-high|medhigh)  echo "15"  ;;
        high)                 echo "15"  ;;
        max|full|uncap)       echo "uncap" ;;
        *)
            if [[ "$input" =~ ^[0-9]+\.?[0-9]*$ ]]; then
                echo "$input"
            else
                echo ""
            fi
            ;;
    esac
}

# ─── Commands ──────────────────────────────────────────────────────────────

cmd_help() {
    echo -e "${BOLD}gpu-dvfs${RESET} — Apple Silicon GPU frequency control"
    echo ""
    echo -e "${BOLD}Quick start:${RESET}"
    echo -e "  ${CYAN}gpu-dvfs status${RESET}              Show GPU state + speed"
    echo -e "  ${CYAN}gpu-dvfs set low${RESET}             Throttle GPU (2W cap)"
    echo -e "  ${CYAN}gpu-dvfs set max${RESET}             Restore full speed"
    echo ""
    echo -e "${BOLD}Named power levels:${RESET}"
    echo -e "  ${CYAN}min${RESET}      1W       GPU floor frequency"
    echo -e "  ${CYAN}low${RESET}      2W       Low power"
    echo -e "  ${CYAN}medium${RESET}  10W       Balanced"
    echo -e "  ${CYAN}high${RESET}    15W       High performance"
    echo -e "  ${CYAN}max${RESET}      —        Uncapped (full speed)"
    echo ""
    echo -e "  Or set any watt value directly: ${CYAN}gpu-dvfs set 7.5${RESET}"
    echo ""
    echo -e "${BOLD}All commands:${RESET}"
    echo -e "  ${CYAN}gpu-dvfs set${RESET} <level|watts>  Set GPU power (name or watts)"
    echo -e "  ${CYAN}gpu-dvfs status${RESET}              Current state + measured speed"
    echo -e "  ${CYAN}gpu-dvfs cap${RESET} <watts>         Raw power cap"
    echo -e "  ${CYAN}gpu-dvfs uncap${RESET}               Restore saved power cap"
    echo -e "  ${CYAN}gpu-dvfs sweep${RESET}               Sweep all levels, measure GFLOPS"
    echo -e "  ${CYAN}gpu-dvfs table${RESET}               Hardware DVFS P-state table"
    echo -e "  ${CYAN}gpu-dvfs info${RESET}                Detect SoC + GPU configuration"
    echo -e "  ${CYAN}gpu-dvfs monitor${RESET}             Live GPU frequency + power"
    echo -e "  ${CYAN}gpu-dvfs build${RESET}               Force rebuild binary"
    echo ""
    echo -e "${BOLD}Flags:${RESET} (pass after the command)"
    echo "  -v, --verbose     Show IOKit calls and raw values"
    echo "  --confirm         Verify frequency via powermetrics"
    echo "  --no-burn         Skip warm-up (faster)"
    echo "  --clpc            Force CLPC fallback (system-wide, has PID lag)"
    echo "  --no-color        Disable colored output"
    echo ""
    echo -e "${DIM}Uses AGX SetMaxGPUAbsolutePower (GPU-only, instant, M1–M5).${RESET}"
    echo -e "${DIM}Falls back to CLPC if AGX path unavailable. sudo for power control.${RESET}"
}

cmd_set() {
    if [ $# -eq 0 ]; then
        log_err "Usage: gpu-dvfs set <level>"
        echo ""
        echo "  Named levels: min, low, medium, high, max"
        echo "  Or a watt value: gpu-dvfs set 3.5"
        exit 1
    fi

    local level="$1"
    shift
    local resolved
    resolved=$(resolve_preset "$level")

    if [ -z "$resolved" ]; then
        log_err "Unknown level: $level"
        echo "  Valid: min, low, medium, high, max, or a number (watts)"
        exit 1
    fi

    if [ "$resolved" = "uncap" ]; then
        log_info "Setting GPU to ${BOLD}max${RESET} (removing power cap)"
        run_sudo uncap "$@"
    else
        log_info "Setting GPU to ${BOLD}${level}${RESET} (${resolved}W cap)"
        run_sudo cap "$resolved" "$@"
    fi
}

cmd_monitor() {
    if [ "$(id -u)" -ne 0 ]; then
        log_warn "monitor needs sudo — re-running with sudo..."
        exec sudo "$0" monitor "$@"
    fi
    log_info "Live GPU frequency + power (Ctrl-C to stop)"
    echo ""
    exec powermetrics --samplers gpu_power -i 500
}

cmd_build() {
    log_info "Force rebuilding..."
    rm -f "$BINARY"
    build_if_needed
}

run_sudo() {
    if [ "$(id -u)" -ne 0 ]; then
        log_warn "This needs sudo — re-running with sudo..."
        exec sudo "$BINARY" "$@"
    else
        "$BINARY" "$@"
    fi
}

# ─── Main ──────────────────────────────────────────────────────────────────

check_requirements

CMD="${1:-help}"
shift || true

case "$CMD" in
    help|--help|-h)
        cmd_help
        ;;
    set)
        build_if_needed
        cmd_set "$@"
        ;;
    build)
        cmd_build
        ;;
    monitor)
        cmd_monitor "$@"
        ;;
    status|cap|uncap|sweep|table|info)
        build_if_needed
        if [[ "$CMD" == "table" || "$CMD" == "info" ]]; then
            "$BINARY" "$CMD" "$@"
        else
            run_sudo "$CMD" "$@"
        fi
        ;;
    *)
        log_err "Unknown command: $CMD"
        echo ""
        cmd_help
        exit 1
        ;;
esac
